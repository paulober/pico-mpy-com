{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": [
      "ES2022",
    ],
    "sourceMap": true,
    "declaration": true,
    "declarationDir": "./dist",
    "rootDir": "src",
    "outDir": "dist",
    "allowJs": false,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16"
  },
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "src/tests"
  ],
  "include": [
    "src/**/*.ts"
  ]
}