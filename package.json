{
  "name": "@paulober/pico-mpy-com",
  "version": "1.0.26",
  "author": "paulober",
  "description": "A nodejs library for communicating with USB devices running the MicroPython firmware.",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulober/pico-mpy-com.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.1"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "module": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "markdown": "github",
  "minimumNodeVersion": 20,
  "scripts": {
    "prepack": "rimraf dist && npm run build",
    "build": "webpack --env build=production",
    "build-tests": "webpack --env build=development",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "pretest": "rimraf test-out",
    "test": "tsc -p tsconfig.test.json && node --test \"test-out/**/*.test.js\"",
    "test:coverage": "tsc -p tsconfig.test.json && node --test --experimental-test-coverage \"test-out/**/*.test.js\"",
    "test:hw": "tsc -p tsconfig.test.json && node --test \"test-out/**/*.hwtest.js\"",
    "test:repl": "npm run build-tests && node ./dist/tests/index.cjs"
  },
  "files": [
    "dist/*.cjs",
    "dist/*.map",
    "dist/*.d.ts"
  ],
  "dependencies": {
    "@serialport/bindings-cpp": "^13.0.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@serialport/bindings-interface": "^1.2.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^20.19",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "rimraf": "^6.1.2",
    "ts-loader": "^9.5.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "packageManager": "npm@11.6.4+sha512.1118cab46a05a50aee6bff5b1b4fa1df18afff89d57465620a3518035026955db87c5bdf9d207b07b7487d99f2490d450cb774655ad63ec2cba7bf1d0ad25d45"
}
